# Rutas privadas (modo 0600) fuera del repositorio.
IACP_DB_PASSWORD_FILE=/etc/iacp/secrets/technical_db_password
IACP_API_TOKEN_FILE=/etc/iacp/secrets/technical_api_token
IACP_ACCESS_ENCRYPTION_KEY_FILE=/etc/iacp/secrets/technical_access_encryption_key
IACP_DEFAULT_SSH_PUBLIC_KEY_FILE=/etc/iacp/secrets/lab_default_ssh_public_key
IACP_PROXMOX_CREDENTIALS_FILE=/etc/iacp/secrets/mng_proxmox_worker.json
IACP_PROXMOX_READONLY_CREDENTIALS_FILE=/etc/iacp/secrets/mng_proxmox_readonly.json
IACP_WASABI_ACCESS_KEY_FILE=/etc/iacp/secrets/wasabi_access_key
IACP_WASABI_SECRET_KEY_FILE=/etc/iacp/secrets/wasabi_secret_key

POSTGRES_DB=iacp_technical
POSTGRES_USER=iacp
IACP_WASABI_BUCKET=iacp-lab-state
IACP_WASABI_REGION=us-east-1
IACP_WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
IACP_VMID_MIN=30000
IACP_VMID_MAX=39999
IACP_MAX_CONCURRENT=2
IACP_API_PORT=8080
