            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InstanceAccepted": {
        "properties": {
          "executor": {
            "const": "simulated",
            "default": "simulated",
            "title": "Executor",
            "type": "string"
          },
          "instance_id": {
            "title": "Instance Id",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "status": {
            "const": "queued",
            "default": "queued",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "instance_id",
          "operation_id"
        ],
        "title": "InstanceAccepted",
        "type": "object"
      },
      "InstanceCreate": {
        "additionalProperties": false,
        "properties": {
          "disk_gb": {
            "default": 20,
            "maximum": 4096.0,
            "minimum": 8.0,
            "title": "Disk Gb",
            "type": "integer"
          },
          "image": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "title": "Image",
            "type": "string"
          },
          "memory_mb": {
            "default": 2048,
            "maximum": 262144.0,
            "minimum": 512.0,
            "multipleOf": 256.0,
            "title": "Memory Mb",
            "type": "integer"
          },
          "name": {
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "title": "Name",
            "type": "string"
          },
          "vcpus": {
            "default": 2,
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Vcpus",
            "type": "integer"
          }
        },
        "required": [
          "name",
          "image"
        ],
        "title": "InstanceCreate",
        "type": "object"
      },
      "InstanceResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "disk_gb": {
            "title": "Disk Gb",
            "type": "integer"
          },
          "executor": {
            "const": "simulated",
            "title": "Executor",
            "type": "string"
          },
          "image": {
            "title": "Image",
            "type": "string"
          },
          "instance_id": {
            "title": "Instance Id",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "memory_mb": {
            "title": "Memory Mb",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "node": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Node"
          },
          "operation_id": {
            "title": "Operation Id",
            "type": "string"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "status": {
            "enum": [
              "pending",
              "provisioning",
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "vcpus": {
            "title": "Vcpus",
            "type": "integer"
          },
          "vmid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vmid"
          }
        },
