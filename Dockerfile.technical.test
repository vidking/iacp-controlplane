FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app

COPY pyproject.toml .
RUN pip install --no-cache-dir \
    "fastapi==0.115.12" \
    "pydantic==2.11.3" \
    "psycopg[binary]==3.2.6" \
    "SQLAlchemy==2.0.41" \
    "alembic==1.15.2" \
    "cryptography==46.0.3" \
    "paramiko==4.0.0" \
    "httpx==0.28.1" \
    "pytest==8.3.5"

COPY api ./api
COPY worker ./worker
COPY terraform ./terraform
COPY compose.technical.yaml .
COPY alembic.ini .
COPY migrations ./migrations
COPY tests/technical ./tests/technical
