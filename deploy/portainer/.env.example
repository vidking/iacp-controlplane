# Candidato del runtime de producción; no representa una aprobación de despliegue.
IACP_IMAGE_REPOSITORY=scm.cyberfuel.com/cyberfuel/iacp-controlplane
IACP_IMAGE_TAG=REEMPLAZAR_CON_TAG_REVISADO
IACP_PUBLIC_DOMAIN=iac.cyberfuel.com
IACP_PROXY_NETWORK=proxy_network
IACP_PROXY_SERVICE_ALIAS=iacp-controlplane-api-prod

# Volúmenes nuevos exclusivos. Elegirlos y revisarlos antes de un futuro corte.
IACP_POSTGRES_VOLUME=iacp_controlplane_prod_postgres
IACP_WORKDATA_VOLUME=iacp_controlplane_prod_workdata
POSTGRES_DB=iacp_controlplane
POSTGRES_USER=iacp
POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_UNICO_DE_POSTGRES

# El endpoint público opera inicialmente sobre MNG. PRX permanece apagado.
IACP_DEFAULT_ENVIRONMENT=lab
IACP_ENABLED_ENVIRONMENTS=lab
IACP_RUNTIME_STAGE=production
IACP_PRX_ENABLED=0
IACP_PROXMOX_MNG_ENDPOINT=https://mng01.cyberfuel.com:8006/
IACP_PROXMOX_MNG_API_TOKEN=REEMPLAZAR_CON_TOKEN_DE_SERVICIO_MNG
IACP_PROXMOX_MNG_POOL_ID=iacp-lab
IACP_PROXMOX_MNG_HOSTNAME=mng01.cyberfuel.com
IACP_PROXMOX_MNG_HOST_IP=REEMPLAZAR_CON_IP_VERIFICADA
# Preparación de PRX: queda deshabilitado hasta confirmar y cargar todos estos datos.
IACP_PROXMOX_PRX_ENDPOINT=
IACP_PROXMOX_PRX_API_TOKEN=
IACP_PROXMOX_PRX_POOL_ID=
IACP_PROXMOX_PRX_CREDENTIALS_FILE=
IACP_PRX_CATALOG=/app/terraform/environments/prx/catalog.json
IACP_TERRAFORM_PRX_DIR=environments/prx

# El runtime de producción usa un prefijo S3 propio. No reutilizar iac/lab.
IACP_TERRAFORM_BACKEND=s3
IACP_TFSTATE_BUCKET=iacp-cyberfuel
IACP_TFSTATE_ENDPOINT=https://s3.us-east-1.wasabisys.com
IACP_TFSTATE_REGION=us-east-1
IACP_TFSTATE_PREFIX=iacp/prod-runtime-v1
IACP_WASABI_ACCESS_KEY_ID=REEMPLAZAR_CON_CREDENCIAL_PROD
IACP_WASABI_SECRET_ACCESS_KEY=REEMPLAZAR_CON_SECRETO_PROD

IACP_API_TOKEN=REEMPLAZAR_CON_TOKEN_API
IACP_REQUIRE_API_TOKEN=1
IACP_ROOT_PASSWORD_MIN_LENGTH=12
IACP_RETENTION_DAYS=0
IACP_MAX_QUEUE_DEPTH=100
IACP_VMID_MIN=40001
IACP_VMID_MAX=49999
IACP_VMID_REUSE=1
IACP_MAX_CONCURRENT=1
IACP_TERRAFORM_TIMEOUT=1800
IACP_POWER_TIMEOUT=180
IACP_PROXMOX_RETRY_ATTEMPTS=6
IACP_PROXMOX_RETRY_BACKOFF=0.5
IACP_POWER_RECOVERY_TIMEOUT=300
IACP_RECONCILE_ATTEMPTS=6
IACP_RECONCILE_TIMEOUT=180
IACP_TERRAFORM_RETRY_ATTEMPTS=4
IACP_OPERATION_STALE_SECONDS=900
IACP_RECOVERY_SCAN_SECONDS=15
IACP_WORKER_POLL_SECONDS=0.5
IACP_WORKER_IDLE_HEARTBEAT_SECONDS=15
IACP_OPERATION_OUTPUT_MAX_CHARS=65536
IACP_DEFAULT_SSH_PUBLIC_KEY=
