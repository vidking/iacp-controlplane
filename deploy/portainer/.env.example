IACP_IMAGE_REPOSITORY=scm.cyberfuel.com/cyberfuel/iacp-controlplanev2
IACP_IMAGE_TAG=develop
IACP_PUBLIC_DOMAIN=dev-iac.cyberfuel.com
IACP_PROXY_NETWORK=proxy_network

# Variables privadas de Portainer. No subir valores reales a Git.
IACP_API_TOKEN=REEMPLAZAR
IACP_REQUIRE_API_TOKEN=1
IACP_ROOT_PASSWORD_MIN_LENGTH=12
IACP_RETENTION_DAYS=0
IACP_PROD_STATIC_ENABLED=0
IACP_NETBOX_URL=https://netbox.cyberfuel.com/api
# ID exacto del prefijo IPv4 /24 autorizado; dejar vacío hasta seleccionarlo.
IACP_NETBOX_PREFIX_ID=
IACP_NETBOX_PREFIX_LENGTH=24
IACP_NETBOX_GATEWAY_HOST=1
IACP_NETBOX_ALLOCATION_TAG=ocupada
IACP_NETBOX_GATEWAY_TAG=reservada
# Token Bearer v2 de un usuario de servicio; no subir valores reales a Git.
IACP_NETBOX_TOKEN=
IACP_NETBOX_VERIFY_TLS=1
IACP_NETBOX_CA_FILE=
IACP_NETBOX_TIMEOUT=15
IACP_NETBOX_RETRY_ATTEMPTS=3
IACP_PROXMOX_ENDPOINT=https://mng01.cyberfuel.com:8006/
IACP_PROXMOX_API_TOKEN=REEMPLAZAR
IACP_PROXMOX_HOSTNAME=mng01.cyberfuel.com
IACP_PROXMOX_HOST_IP=REEMPLAZAR_CON_IP_VERIFICADA
IACP_PROXMOX_POOL_ID=iacp-lab
IACP_POWER_TIMEOUT=180
IACP_POWER_RECOVERY_TIMEOUT=300
IACP_PROXMOX_RETRY_ATTEMPTS=6
IACP_TERRAFORM_RETRY_ATTEMPTS=4
IACP_OPERATION_STALE_SECONDS=900
IACP_RECOVERY_SCAN_SECONDS=15
IACP_WORKER_POLL_SECONDS=0.5
IACP_WORKER_IDLE_HEARTBEAT_SECONDS=15
IACP_OPERATION_OUTPUT_MAX_CHARS=65536

# Clave pública SSH de una sola línea.
IACP_DEFAULT_SSH_PUBLIC_KEY=ssh-ed25519 AAAA_REEMPLAZAR

IACP_VMID_MIN=40001
IACP_VMID_MAX=49999
IACP_VMID_REUSE=1
IACP_MAX_CONCURRENT=6
IACP_MAX_QUEUE_DEPTH=100
IACP_TERRAFORM_TIMEOUT=1800
