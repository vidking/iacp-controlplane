IACP_DATABASE_URL=postgresql://iacp:CAMBIAR_POR_SECRETO@postgres:5432/iacp_controlplane
POSTGRES_DB=iacp_controlplane
POSTGRES_USER=iacp
POSTGRES_PASSWORD=CAMBIAR_POR_SECRETO
IACP_TERRAFORM_PATH=/workspace/terraform
IACP_TERRAFORM_DIR=environments/mng01
IACP_LOCAL_TERRAFORM_DIR=fixtures/local
IACP_WORKER_COUNT=2
IACP_REQUIRE_API_TOKEN=1
IACP_API_TOKEN=CAMBIAR_POR_TOKEN_SEGURO
IACP_ROOT_PASSWORD_MIN_LENGTH=12
IACP_PROD_STATIC_ENABLED=0
IACP_NETBOX_URL=https://netbox.cyberfuel.com/api
IACP_NETBOX_PREFIX_ID=
IACP_NETBOX_PREFIX_LENGTH=24
IACP_NETBOX_GATEWAY_HOST=1
IACP_NETBOX_ALLOCATION_TAG=ocupada
IACP_NETBOX_GATEWAY_TAG=reservada
# Token de servicio de NetBox; no subirlo a Git.
IACP_NETBOX_TOKEN=
IACP_NETBOX_VERIFY_TLS=1
IACP_NETBOX_CA_FILE=
IACP_NETBOX_TIMEOUT=15
IACP_NETBOX_RETRY_ATTEMPTS=3
IACP_RETENTION_DAYS=0
IACP_PUBLIC_URL=https://iac.cyberfuel.com
IACP_SECRET_ROOT=/var/lib/iacp-controlplane/operation-secrets
IACP_API_PORT=8080
IACP_VMID_MIN=40001
IACP_VMID_MAX=49999
IACP_VMID_REUSE=1
IACP_MAX_CONCURRENT=2
IACP_MAX_QUEUE_DEPTH=0
# Archivo JSON con PROXMOX_VE_ENDPOINT y PROXMOX_VE_API_TOKEN; nunca se sube a Git.
IACP_PROXMOX_CREDENTIALS_FILE=./secrets/proxmox_credentials.example.json
IACP_PROXMOX_POOL_ID=iacp-lab
IACP_PROXMOX_HOSTNAME=mng01.cyberfuel.com
IACP_PROXMOX_HOST_IP=192.168.1.113
IACP_POWER_RECOVERY_TIMEOUT=300
IACP_PROXMOX_RETRY_ATTEMPTS=6
IACP_TERRAFORM_RETRY_ATTEMPTS=4
IACP_OPERATION_STALE_SECONDS=900
IACP_RECOVERY_SCAN_SECONDS=15
IACP_WORKER_POLL_SECONDS=0.5
IACP_WORKER_IDLE_HEARTBEAT_SECONDS=15
IACP_OPERATION_OUTPUT_MAX_CHARS=65536
# En pruebas MNG se puede pasar la clave pública como variable de entorno.
IACP_DEFAULT_SSH_PUBLIC_KEY=
