# Desarrollo local del candidato. No usar este archivo para producción.
IACP_API_IMAGE=iacp-controlplane:local
IACP_API_PORT=8080
IACP_PUBLIC_URL=http://localhost:8080

# PostgreSQL local y volumen local de trabajo.
POSTGRES_DB=iacp_controlplane
POSTGRES_USER=iacp
POSTGRES_PASSWORD=CAMBIAR_EN_DESARROLLO_LOCAL
PGDATABASE=iacp_controlplane
PGUSER=iacp
PGPASSWORD=CAMBIAR_EN_DESARROLLO_LOCAL
PGHOST=postgres
PGPORT=5432
IACP_POSTGRES_VOLUME=iacp_controlplane_dev_postgres
IACP_WORKDATA_VOLUME=iacp_controlplane_dev_workdata

# Este endpoint usa solo MNG y conserva el state local en el volumen de trabajo.
IACP_DEFAULT_ENVIRONMENT=lab
IACP_ENABLED_ENVIRONMENTS=lab
IACP_RUNTIME_STAGE=develop
IACP_TERRAFORM_BACKEND=local
IACP_TFSTATE_PREFIX=
IACP_PRX_ENABLED=0
IACP_PROXMOX_MNG_ENDPOINT=https://mng01.cyberfuel.com:8006/
IACP_PROXMOX_MNG_API_TOKEN=REEMPLAZAR_CON_TOKEN_DE_DESARROLLO
IACP_PROXMOX_MNG_POOL_ID=iacp-lab
IACP_PROXMOX_MNG_HOSTNAME=mng01.cyberfuel.com
IACP_PROXMOX_MNG_HOST_IP=REEMPLAZAR_CON_IP_VERIFICADA

IACP_API_TOKEN=
IACP_REQUIRE_API_TOKEN=0
IACP_ROOT_PASSWORD_MIN_LENGTH=12
IACP_RETENTION_DAYS=0
IACP_MAX_QUEUE_DEPTH=0
IACP_VMID_MIN=40001
IACP_VMID_MAX=49999
IACP_VMID_REUSE=1
IACP_MAX_CONCURRENT=1
IACP_TERRAFORM_TIMEOUT=1800
IACP_POWER_TIMEOUT=180
IACP_PROXMOX_RETRY_ATTEMPTS=6
IACP_PROXMOX_RETRY_BACKOFF=0.5
IACP_POWER_RECOVERY_TIMEOUT=300
IACP_RECONCILE_ATTEMPTS=6
IACP_RECONCILE_TIMEOUT=180
IACP_TERRAFORM_RETRY_ATTEMPTS=4
IACP_OPERATION_STALE_SECONDS=900
IACP_RECOVERY_SCAN_SECONDS=15
IACP_WORKER_POLL_SECONDS=0.5
IACP_WORKER_IDLE_HEARTBEAT_SECONDS=15
IACP_OPERATION_OUTPUT_MAX_CHARS=65536
IACP_DEFAULT_SSH_PUBLIC_KEY=
