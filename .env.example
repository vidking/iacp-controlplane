IACP_DB_PATH=/var/lib/iacp-v2/iacp.sqlite
IACP_TERRAFORM_PATH=/workspace/terraform
IACP_TERRAFORM_DIR=environments/mng01
IACP_LOCAL_TERRAFORM_DIR=fixtures/local
IACP_WORKER_COUNT=2
IACP_API_TOKEN=
IACP_PUBLIC_URL=https://dev.iac.cyberfuel.com
IACP_API_PORT=8080
IACP_VMID_MIN=40000
IACP_VMID_MAX=49999
IACP_MAX_CONCURRENT=2
# Archivo JSON con PROXMOX_VE_ENDPOINT y PROXMOX_VE_API_TOKEN; nunca se sube a Git.
IACP_PROXMOX_CREDENTIALS_FILE=./secrets/proxmox_credentials.example.json
# En pruebas MNG se puede pasar la clave pública como variable de entorno.
IACP_DEFAULT_SSH_PUBLIC_KEY=

